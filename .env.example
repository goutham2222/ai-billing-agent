# Server Configuration
FASTIFY_PORT=3000
NODE_ENV=development

# Evolution API (WhatsApp Gateway)
EVOLUTION_API_URL=http://localhost:8085
EVOLUTION_API_KEY=your_evolution_api_key_here
BILLING_INSTANCE_NAME=billing_bot
MANAGER_INSTANCE_NAME=manager_bot

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=billing-media

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Manager Bot Database Connection (Direct Read-Only Role for Text-to-SQL)
# e.g., postgresql://readonly_user:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
READONLY_DATABASE_URL=postgresql://readonly_user:password@db.your-project.supabase.co:5432/postgres

# Business / Authorization Configuration (Optional)
STORE_OWNER_PHONE=919876543210
